# Database Connection (PostgreSQL or local SQLite for testing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackerearth_db?schema=public"

# AI Model Provider API Keys
# 1. Google Gemini (Recomendado y con capa gratuita): https://aistudio.google.com/app/apikey
GEMINI_API_KEY="tu_gemini_api_key_aqui"

# 2. OpenAI (Opcional para GPT-4o / GPT-4o Mini): https://platform.openai.com/api-keys
OPENAI_API_KEY="tu_openai_api_key_aqui"

# 3. Anthropic Claude (Opcional para Claude 3.7 / 3.5): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="tu_anthropic_api_key_aqui"

# Server Port
PORT=4000
NODE_ENV=development
